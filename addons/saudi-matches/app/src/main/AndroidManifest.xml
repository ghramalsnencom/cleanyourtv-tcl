<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="مباريات اليوم"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false">

        <activity android:name=".DashboardActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Module card for the Clean Your TV launcher (docs/modules.md). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- The matches page, by day and competition. Exported: the home screen's game cards open it. -->
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" />

        <!-- Today's games and prayer times for the home screen (read-only; the launcher has no network). -->
        <provider
            android:name=".MatchesProvider"
            android:authorities="com.saad.tv.matches.feed"
            android:exported="true" />

        <service
            android:name=".MatchesDream"
            android:exported="true"
            android:label="مباريات اليوم والصلاة"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
